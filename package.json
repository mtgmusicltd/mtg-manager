{
  "name": "mtg-manager",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "MTG Harmonizer Software Manager",
  "author": "MTG Music Ltd",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:mac": "pnpm run electron:build:mac:zip:arm64 && pnpm run electron:build:mac:zip:x64 && pnpm run electron:build:mac:pkg:arm64 && pnpm run electron:build:mac:pkg:x64",
    "electron:build:mac:zip:arm64": "vite build && electron-builder --mac --arm64 --config.mac.target.0.target=zip --config.mac.target.0.arch.0=arm64",
    "electron:build:mac:zip:x64": "electron-builder --mac --x64 --config.mac.target.0.target=zip --config.mac.target.0.arch.0=x64",
    "electron:build:mac:pkg:arm64": "electron-builder --mac --arm64 --config.mac.target.0.target=pkg --config.mac.target.0.arch.0=arm64",
    "electron:build:mac:pkg:x64": "electron-builder --mac --x64 --config.mac.target.0.target=pkg --config.mac.target.0.arch.0=x64",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:all": "vite build && electron-builder --mac --win",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "electron-updater": "^6.3.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.mtg.manager",
    "productName": "MTG Manager",
    "copyright": "Copyright © 2025 MTG Music Ltd",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build-assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/electron-updater/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build-assets/icon.icns",
      "target": [
        { "target": "zip", "arch": ["arm64"] }
      ],
      "darkModeSupport": true,
      "minimumSystemVersion": "13.0.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-assets/entitlements.mac.plist",
      "entitlementsInherit": "build-assets/entitlements.mac.plist",
      "identity": null
    },
    "pkg": {
      "identity": "MTG Music Ltd (Y8DUR246JM)"
    },
    "publish": {
      "provider": "generic",
      "url": "https://mtg-licensing-api-production.up.railway.app/updates/"
    }
  }
}
