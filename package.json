{
  "name": "mtg-manager",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "MTG Harmonizer Software Manager",
  "author": "MTG Music Ltd",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "pnpm electron:build:mac",
    "electron:build:mac": "vite build && electron-builder --config build-assets/eb-zip-mac.json && node scripts/write-arm64-manifest.mjs && electron-builder --config build-assets/eb-pkg-arm64.json && electron-builder --config build-assets/eb-pkg-x64.json && node scripts/verify-mac-release.mjs && node scripts/stage-manual-installers.mjs",
    "release:verify:mac": "node scripts/verify-mac-release.mjs",
    "release:stage:manual": "node scripts/stage-manual-installers.mjs",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:all": "pnpm electron:build:mac && electron-builder --win",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "electron-updater": "^6.3.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.mtg.manager",
    "productName": "MTG Manager",
    "copyright": "Copyright © 2025 MTG Music Ltd",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build-assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/electron-updater/**/*"
    ],
    "extraResources": [
      {
        "from": "build-assets/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build-assets/icon.icns",
      "target": [
        { "target": "zip", "arch": ["arm64"] },
        { "target": "zip", "arch": ["x64"] },
        { "target": "pkg", "arch": ["arm64"] },
        { "target": "pkg", "arch": ["x64"] }
      ],
      "darkModeSupport": true,
      "minimumSystemVersion": "13.0.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-assets/entitlements.mac.plist",
      "entitlementsInherit": "build-assets/entitlements.mac.plist",
      "identity": "FE8DC59AE672F19A8BA996F34566E033FFF12627"
    },
    "pkg": {
      "identity": "MTG Music LTD (Y8DUR246JM)"
    },
    "publish": {
      "provider": "generic",
      "url": "https://mtg-licensing-api-production.up.railway.app/updates/"
    }
  }
}
